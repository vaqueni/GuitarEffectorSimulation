guitar_files = {
    'DATA/clean1.wav'
    'DATA/janray.wav'
};


% wav 읽기
x = cell(1,2);
[x{1}, fs] = audioread(guitar_files{1});
[x{2}, ~]  = audioread(guitar_files{2});

% stereo일 경우 mono 변환
for i = 1:length(x)
    if size(x{i},2) > 1
        x{i} = x{i}(:,1);
    end
end

% 길이 맞추기
N = min(length(x{1}), length(x{2}));
x{1} = x{1}(1:N);
x{2} = x{2}(1:N) ;

% FFT
X1 = fft(x{1});
X2 = fft(x{2});

% H(f) 계산
eps = 1e-10;
H = Y ./ (X1 + eps);
% 주파수 축
f = (0:N-1)*(fs/N);

% magnitude (dB)
H_mag = 20*log10(abs(H) + 1e-12);
%plot (양수 주파수만)
half = floor(N/2);
% 아래과정을 진행함으로서 구간별 평균값을 표기해서 smooth한 그래프를 출력한다.
window_size = 200;
% H_smooth = sgolayfilt(H_mag,3,201);
H_smooth = movmean(H_mag, window_size);

figure

plot(f(1:half), H_mag(1:half), 'Color', [0.8 0.8 0.8])% 원본 (연하게)
hold on
plot(f(1:half), H_smooth(1:half), 'r', 'LineWidth',2)
xlabel('Frequency (Hz)')
ylabel('Magnitude (dB)')
title('Smoothed H(f)')
grid on

figure
plot(f(1:half))